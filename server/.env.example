# Bu dosyayı `.env` adıyla kopyalayıp doldurun. `.env` git'e girmez.

# --- Veritabanı (zorunlu) ---
# Neon, Supabase veya başka bir Postgres sağlayıcısından aldığınız bağlantı adresi.
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require
# Kurulum yapmadan denemek isterseniz (veriler kalıcı olmaz):
# DATABASE_URL=pglite
# Sağlayıcınız kendi imzaladığı bir sertifika kullanıyorsa:
# DATABASE_SSL_INSECURE=1

# --- Oturum imza anahtarı ---
# Yayında MUTLAKA ayarlayın: değişirse tüm kullanıcıların oturumu kapanır.
# Rastgele üretmek için:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- E-posta (opsiyonel) ---
# Tanımlanmazsa uygulama yine çalışır; şifre sıfırlama kodu e-posta yerine
# sunucu günlüğüne yazılır.
#
# Gmail örneği: normal Gmail şifreniz ÇALIŞMAZ. Google Hesabı > Güvenlik >
# 2 Adımlı Doğrulama'yı açtıktan sonra "Uygulama şifreleri" bölümünden
# 16 haneli bir şifre üretin ve SMTP_PASS alanına onu yazın.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ornek@gmail.com
SMTP_PASS=uygulama-sifresi-16-hane
SMTP_FROM=Focus <ornek@gmail.com>
